{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-cmdline-guard.js\"",
            "timeout": 10,
            "statusMessage": "Checking command length"
          }
        ]
      }
    ]
  }
}
